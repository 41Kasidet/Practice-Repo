        "# Set Pipeline\n",
        "from pyspark.ml.classification import DecisionTreeClassifier\n",
        "\n",
        "vector_assembler = VectorAssembler(inputCols=feature_columns, outputCol=\"featureVector\")\n",
        "\n",
        "classifier = DecisionTreeClassifier(seed=42,\n",
